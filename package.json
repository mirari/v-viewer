{
  "name": "v-viewer-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm run docs:dev",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "build": "node scripts/build.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:packages && pnpm run docs:build",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:dev": "pnpm run docs:prepare && vitepress dev docs --host 127.0.0.1 --port 5190",
    "docs:build": "pnpm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 5190",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@vue/compiler-sfc": "3.5.43",
    "acorn": "8.19.0",
    "codemirror": "6.0.2",
    "commit-and-tag-version": "13.3.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "core-js": "3.50.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "semver": "7.7.4",
    "typescript": "7.0.2",
    "viewerjs": "^1.11.7",
    "viewerjs-min": "npm:viewerjs@1.11.7",
    "vite": "8.3.4",
    "vitepress": "1.6.4",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue2-min": "npm:vue@2.4.0",
    "vue3-min": "npm:vue@3.0.0"
  }
}
